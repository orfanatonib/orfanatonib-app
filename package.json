{
  "name": "sheltersnib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start:local": "dotenv -e env/env.local -- vite",
    "start:staging": "dotenv -e env/env.staging -- vite",
    "start:prod": "dotenv -e env/env.prod -- vite",
    "build": "vite build",
    "prebuild": "npm run type-check",
    "preview": "vite preview --open",
    "test": "vitest",
    "test:unit": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run src/utils --coverage",
    "check:test-ids": "node scripts/check-test-ids.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "E2E_SLOWMO=400 playwright test --project=live-ui --headed --workers=1",
    "test:e2e:report": "playwright show-report e2e/.report",
    "test:e2e:live": "playwright test",
    "seed:acolhidos": "E2E_SEED=1 playwright test --config=playwright.live.config.ts --workers=1 --project=live-seed",
    "seed:acolhidos:clean": "node e2e/live/sheltered-area/clean-mass.mjs",
    "test:e2e:live:api": "playwright test --project=live-api",
    "test:e2e:live:ui": "playwright test --project=live-ui",
    "test:e2e:live:headed": "E2E_SLOWMO=400 playwright test --project=live-ui --headed",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "validate": "npm run type-check && npm run lint",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "check:scenarios": "node scripts/check-scenario-coverage.mjs",
    "check:scenarios:studio": "node scripts/check-scenario-coverage.mjs --unit=content-studio",
    "check:routes": "node scripts/check-route-coverage.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.1",
    "@mui/icons-material": "^6.4.11",
    "@mui/material": "^6.4.11",
    "@mui/x-date-pickers": "^8.23.0",
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.6.1",
    "@sentry/react": "^10.34.0",
    "@sentry/tracing": "^7.120.4",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "axios": "^1.8.4",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.6.5",
    "lucide-react": "^0.487.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.61.1",
    "react-icons": "^5.4.0",
    "react-imask": "^7.6.1",
    "react-input-mask-next": "^3.0.0-alpha.12",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "react-slick": "^0.30.3",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.2.5",
    "web-vitals": "^2.1.4",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.0.8",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-input-mask": "^3.0.6",
    "@types/react-redux": "^7.1.34",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^25.0.0",
    "mysql2": "^3.24.6",
    "prettier": "^3.5.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.2",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.16"
  }
}
